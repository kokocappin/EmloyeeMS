datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  EMPLOYEE
}

model User {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  email      String @unique
  password   String
  role       Role @default(EMPLOYEE)

  phone      String?
  address    String?
  department String?
  position   String?

  birthdate  String?
  salary     String?
  sex        String?

  notes      String?
  isActive   Boolean @default(true)
}